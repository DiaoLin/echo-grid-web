# 外部 PostgreSQL 连接（必填，二选一）
# 方式一：连接串，例如 postgres://user:password@host:5432/database
# 方式二：改用标准 PGHOST / PGPORT / PGDATABASE / PGUSER / PGPASSWORD
DATABASE_URL=

PGSSL=false

# 服务端口
PORT=3000

# 可选：设置后，上传接口需要携带 Authorization: Bearer <token> 或 X-API-Key: <token>
INGEST_TOKEN=

# 允许跨域的前端来源，多个用逗号分隔；* 表示允许全部
CORS_ORIGIN=*

# 采集时间没有带时区时，按此偏移解释（默认北京时间）
APP_TZ_OFFSET=+08:00

# 超过多少分钟没有新数据就视为离线
ONLINE_WINDOW_MINUTES=5

# 查询默认条数与最大条数
DEFAULT_LIMIT=200
MAX_LIMIT=5000

# CSV 单次导出的最大行数
MAX_EXPORT_ROWS=100000
